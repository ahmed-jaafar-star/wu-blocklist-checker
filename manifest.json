{
  "manifest_version": 3,
  "name": "Wu BlockList Checker",
  "version": "1.1.0",
  "description": "Batch MSISDN lookup using the authorized Wu BlockList page",
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://cms.example.com/*"
  ],
  "action": {
    "default_title": "Wu BlockList Checker",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cms.example.com/app/mobile-menus*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
